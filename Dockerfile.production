FROM php:8.3-apache

# Enable Apache modules
RUN a2enmod rewrite

# Install system dependencies & PHP extensions
RUN apt-get update && apt-get install -y \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libxml2-dev \
    libwebp-dev \
    libpng-dev \
    libzip-dev \
    libonig-dev \
    libcurl4-openssl-dev \
    libicu-dev \
    && docker-php-ext-configure gd --with-webp --with-jpeg \
    && docker-php-ext-install -j$(nproc) gd \
    && docker-php-ext-install xml dom curl mbstring intl gettext zip mysqli opcache \
    && pecl bundle -d /usr/src/php/ext apcu \
    && docker-php-ext-install /usr/src/php/ext/apcu \
    && docker-php-ext-enable apcu opcache \
    && rm -rf /var/lib/apt/lists/*

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Production php.ini
COPY php.ini ${PHP_INI_DIR}

# Document root phải là public/
ENV APACHE_DOCUMENT_ROOT /var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf \
    && sed -ri -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf

# Copy source (excluding runtime/cache dirs via .dockerignore)
COPY --chown=www-data:www-data . /var/www/html/

WORKDIR /var/www/html

USER www-data

# Create runtime directories and set permissions
RUN mkdir -p \
    storage/cache \
    storage/compiled-templates \
    storage/model \
    public/page-cache \
    public/media \
    public/themes \
    public/image-cache \
    plugins \
    config \
    && chown -R www-data:www-data storage public/page-cache config public/media public/themes public/image-cache plugins \
    && chmod -R 775 storage public/page-cache config public/media public/themes public/image-cache plugins \
    && chmod -R 755 public app config system rest graphql plugins vendor

# Install Composer dependencies (production)
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Production-safe defaults (có thể ghi đè bằng biến môi trường Coolify)
ENV DEBUG=false \
    PAGE_CACHE=false \
    SQL_CHECK=false \
    VTPL_DEBUG=false \
    DB_ENGINE=mysqli

# Expose Apache port
EXPOSE 80

# Entrypoint: chờ DB sẵn sàng, chạy install nếu chưa có config/db.php, sau đó chạy Apache
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["apache2-foreground"]
